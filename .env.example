# Copy to .env and fill in your MongoDB details. Everything is read from the
# environment. You only need ONE of the two options below.

# ── Option A: paste a full connection string (recommended, e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── Option B: or provide the parts and a URI is assembled for you
# MONGODB_SCHEME=mongodb            # use "mongodb+srv" for Atlas SRV hosts
# MONGODB_USERNAME=myuser
# MONGODB_PASSWORD=mypassword
# MONGODB_HOST=localhost:27017      # host[:port] (or the Atlas cluster host)
# MONGODB_OPTIONS=retryWrites=true&w=majority

# Where data is written (defaults shown):
MONGODB_DATABASE=startup_intel
MONGODB_COLLECTION=startups

# ── Optional tuning (defaults shown) ────────────────────────────────────────
# SIA_HN_TAGS=show_hn
# SIA_HN_HITS=50
# SIA_HTTP_USER_AGENT=startup-intel-agent/1.0
# SIA_HTTP_TIMEOUT_MS=15000
# SIA_ENABLE_TECH_DETECTION=true
# SIA_LOG_LEVEL=info
# SIA_CONFIG=/etc/sia/config.json   # optional JSON file overriding the above
